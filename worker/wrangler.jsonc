{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mango-mail",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-09",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Builds（面板直连 Git）部署用。
  //
  // 绑定写在这里，但只留占位符，不写真实 ID——部署时由构建变量填进去：
  //   D1 绑定名 DB，KV 绑定名 KV，R2 绑定名 R2。
  // 构建变量在面板设置：Workers → mango-mail → Settings → Builds → Variables and secrets，
  //   D1_ID（机密）：D1 数据库 ID；KV_ID（机密）：KV 命名空间 ID。
  // 部署命令（package.json 的 deploy:builds）会先跑 scripts/render-build-config.mjs，
  // 把占位符换成构建变量的值，生成 worker/wrangler-deploy.jsonc 再部署。
  // 这样仓库里不含真实 ID，别人 Fork 后填自己的构建变量就能部署；
  // 而部署时配置里始终有真实绑定，面板里的绑定也不会再被删掉（2026-11-14 就这么丢过一次）。
  // R2 只要桶名，直接写在这里，不用变量。
  // 本地部署没有构建变量时，在命令行前面加上 D1_ID=... KV_ID=... 再跑 npm run deploy:builds；
  // 本地开发如需别的 D1/KV，在本地另填一份 wrangler.jsonc，不要推上去。
  "keep_vars": true,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mango-mail-db",
      "database_id": "REPLACE_D1_DATABASE_ID"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "REPLACE_KV_NAMESPACE_ID"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "mango-mail-r2"
    }
  ],

  "observability": {
    "enabled": true
  }

  // 注意：这里故意不写 vars，也不写 triggers.crons。
  // 变量（APP_NAME / ADMIN_EMAIL / MAIL_DOMAINS / ALLOW_REGISTER / DEFAULT_QUOTA /
  // PROVIDER_STRATEGY）只在面板 Settings → Variables 里填，不要写进这里——
  // 写进去的话，每次部署都会用配置文件里的值盖掉面板里的值。
  // keep_vars: true 会保住面板里填的变量，部署时不碰它们。
  // JWT_SECRET 也只放面板（添加变量 → 添加机密），不要写进仓库。
  // 它同时是 /api/init/<JWT_SECRET> 的口令，值随便打一个别人猜不到的字符串，
  // 不能含 ? % # / \ | &，部署后别改。
  // triggers：免费版账号最多 5 个 cron 触发器，aa 的账号已经满了，再加一个会报 10072
  // 导致整个部署失败。去掉后收信、发信都正常，只是每天定时日清 / 配额重置不跑。
  // 以后腾出一个 cron 名额（删掉别的 Worker 上不用的定时任务）再把下面这段加回来：
  // "triggers": { "crons": ["0 16 * * *"] }
}
